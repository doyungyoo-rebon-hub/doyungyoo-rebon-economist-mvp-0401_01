# ====================================================================
# AI 증권사 리포트 평가 & 파이프라인 (On-Premise Production Dockerfile)
# Node.js 20 LTS 기반 경량화 프로덕션 이미지
# ====================================================================
FROM node:20-alpine AS runner

# 필수 폰트 및 유틸리티 패키지 설치
RUN apk add --no-cache tzdata ca-certificates

# 타임존 설정 (Asia/Seoul)
ENV TZ=Asia/Seoul
ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

# 패키지 매니페스트 복사 및 의존성 설치
COPY package.json ./
RUN npm install --omit=dev --legacy-peer-deps

# 소스코드 및 데이터 디렉토리 복사
COPY . .

# 프론트엔드 및 백엔드 번들 빌드 실행
# (Vite SPA 정적 자산 생성 및 esbuild 서버 번들링)
RUN npx vite build && npx esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs

# 데이터 영속성을 위한 볼륨 지정 (마스터 DB 및 PDF 보관 디렉토리)
VOLUME ["/app/downloads"]

# 서비스 포트 개방 (내부 3000번 기본, 호스트 매핑 시 80 또는 8080 가능)
EXPOSE 3000 8080

# 헬스체크 구성
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-3000}/api/health || exit 1

# 프로덕션 서버 구동
CMD ["node", "dist/server.cjs"]
